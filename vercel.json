{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm test && npm run build:vercel",
  "outputDirectory": "apps/web/dist-vercel",
  "git": { "deploymentEnabled": true },
  "rewrites": [
    { "source": "/callback", "destination": "https://trace-api.103-201-130-12.sslip.io/callback" },
    { "source": "/api/search/:path*", "destination": "https://trace-api.103-201-130-12.sslip.io/api/search/:path*" },
    { "source": "/api/zhihu/:path*", "destination": "https://trace-api.103-201-130-12.sslip.io/api/zhihu/:path*" },
    { "source": "/((?!api/|assets/|home/|matters/|product/|legacy\\.html|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
