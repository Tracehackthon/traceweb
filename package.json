{
  "name": "traceweb",
  "version": "0.1.0",
  "private": true,
  "description": "Trace Web application and desktop companion deployment source",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "start": "npm --prefix apps/web start",
    "build": "npm run build:web",
    "build:web": "npm --prefix apps/web run build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:pet": "npm --prefix apps/desktop-pet run build",
    "release:checksum": "node scripts/checksum-release.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test:release-tools": "node --test scripts/release-tools.test.mjs",
    "desktop:pet": "npm --prefix apps/desktop-pet run desktop",
    "test:browser-storage": "node scripts/browser-storage-e2e.cjs",
    "test:demo-storage": "node scripts/demo-storage-compat-e2e.cjs",
    "test": "npm --prefix apps/web test",
    "test:e2e": "node scripts/product-e2e.cjs",
    "test:canvas": "node scripts/canvas-interactions-e2e.cjs",
    "test:desktop-capabilities": "node --test scripts/desktop-capability-bridge.test.mjs",
    "test:experience": "node scripts/experience-e2e.cjs",
    "test:ui-renovation": "node scripts/ui-renovation-e2e.cjs",
    "video:studio": "remotion studio video/src/index.tsx --public-dir=video/public --no-open",
    "video:render": "remotion render video/src/index.tsx TraceDemo apps/web/public/video/trace-demo.mp4 --public-dir=video/public --codec=h264 --crf=23 --pixel-format=yuv420p",
    "video:poster": "remotion still video/src/index.tsx TraceDemo apps/web/public/video/trace-demo-poster.jpg --public-dir=video/public --frame=90 --image-format=jpeg"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.506",
    "@remotion/transitions": "^4.0.506",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.62.1",
    "remotion": "^4.0.506",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
